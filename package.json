{
  "name": "product-management-learning-system",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Offline, single-file player for self-directed training packages.",
  "scripts": {
    "build": "npm run build:learner && npm run build:authoring",
    "build:learner": "node scripts/build.mjs",
    "build:authoring": "node scripts/build-authoring.mjs",
    "export:course": "node scripts/build.mjs --course",
    "export:all": "node scripts/export-all.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:authoring": "tsc -p tsconfig.authoring.json --noEmit",
    "qa:authoring": "node scripts/qa-authoring.mjs",
    "qa:release": "node scripts/qa-release.mjs",
    "qa": "node scripts/qa.mjs",
    "qa:exports": "node scripts/qa-exports.mjs",
    "course:inspect": "node scripts/install-course-package.mjs --inspect",
    "course:install": "node scripts/install-course-package.mjs --install",
    "course:host": "node scripts/install-course-package.mjs --host",
    "verify:authoring": "npm run typecheck:authoring && npm run build:authoring && npm run qa:authoring",
    "verify": "npm run typecheck && npm run typecheck:authoring && npm run build && npm run qa && npm run qa:exports && npm run qa:authoring && npm run qa:release"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.49.1",
    "typescript": "~5.7.2"
  }
}
